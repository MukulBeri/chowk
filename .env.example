# Placeholder only. Put real credentials in ignored .env.local; never NEXT_PUBLIC_.
GEMINI_API_KEY=replace_with_your_server_side_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Fail closed for public operation; true requires separate eligible-use approval.
GEMINI_ENABLED=false
GEMINI_TIMEOUT_MS=18000
GENERATION_TIMEOUT_MS=38000
GEMINI_RPM_BUDGET=8
GEMINI_DAILY_BUDGET=100
GEMINI_TPM_BUDGET=100000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_CONCURRENCY=2

# Public canonical origin; omit or use this owner-verified value (stale values fail build).
CHOWK_PRODUCTION_ORIGIN=https://chowk-studio.vercel.app

# M9 source support only. Owner setup/activation requires separate approval.
CHOWK_AI_ENABLED=false
CHOWK_AI_KILL_SWITCH=true
META_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CHOWK_SOURCE_HASH_SECRET=
CHOWK_AI_BUDGET_EPOCH=owner-approved-pilot
CHOWK_AI_MAX_CALLS=0
CHOWK_AI_MAX_RESERVATION_MICROS=0
CHOWK_AI_SOURCE_CALLS_PER_MINUTE=3
CHOWK_AI_ALLOWED_COUNTRIES=IN
CHOWK_AI_IMAGE_POLICY=private
